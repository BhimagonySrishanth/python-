class CIRCLE:
    def __init__(self):
        x=int(input("Enter radius: "))
        self.radius=x
    def display(self):
        print("area of circle: ",3.14*self.radius**2)
a=int(input("enter the num of circle: "))
circle=[]
for i in range(a):
    c=CIRCLE()
    circle.append(c)
    c.display()
    print("_______")
